# ============================================
# 일본 뉴스 학습 앱 환경 변수 템플릿
# 본 파일을 .env 로 복사한 뒤 실제 값을 채워주십시오.
# Expo 클라이언트에서 노출되는 변수는 EXPO_PUBLIC_ 접두사가 필요합니다.
# ============================================

# --- Supabase (앱 클라이언트용 / 공개 가능) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase (n8n 서버용 / 절대 공개 금지) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- LLM API (n8n 서버에서만 사용) ---
GROQ_API_KEY=your-groq-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- 뉴스 소스 (선택) ---
NEWS_RSS_URLS=https://www3.nhk.or.jp/rss/news/cat0.xml,https://www.asahi.com/rss/asahi/newsheadlines.rdf
