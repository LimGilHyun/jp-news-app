{
  "expo": {
    "name": "일본 뉴스 일본어 학습",
    "slug": "japanese-news-learner",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.jpnewslearner"
    },
    "android": {
      "package": "com.example.jpnewslearner",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#6366f1"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "56979706-e47a-4071-9220-e049b952ac93"
      }
    },
    "owner": "ghpjt"
  }
}
